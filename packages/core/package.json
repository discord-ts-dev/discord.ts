{
  "name": "@discord-ts-dev/core",
  "version": "1.2.1",
  "description": "discord.ts runtime: module, discovery, sync, guards, config, sharding",
  "homepage": "https://github.com/discord-ts-dev/discord.ts#readme",
  "bugs": {
    "url": "https://github.com/discord-ts-dev/discord.ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/discord-ts-dev/discord.ts.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "oxlint .",
    "format": "oxfmt --write src",
    "test": "bun test --preload=../../scripts/test-preload.ts"
  },
  "dependencies": {
    "@discord-ts-dev/common": "^1.2.1",
    "@discord-ts-dev/i18n": "^0.3.2",
    "@discord-ts-dev/utils": "^0.4.1",
    "@discord-ts-dev/ux": "^1.2.1",
    "class-validator": "^0.15.1",
    "discord.js": "^14.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "fast-check": "^4.10.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "discord.js": "^14.0.0"
  }
}
