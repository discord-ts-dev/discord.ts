{
  "name": "@discord.ts/i18n",
  "version": "0.1.0",
  "description": "discord.ts native i18n: namespaced locale catalogs, translate, locale resolve",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "oxlint .",
    "format": "oxfmt --write src",
    "test": "bun test"
  },
  "dependencies": {
    "@discord.ts/common": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.6.3"
  }
}
