{
  "name": "@discord-ts-dev/i18n",
  "version": "0.3.1",
  "description": "discord.ts native i18n: namespaced locale catalogs, translate, locale resolve",
  "homepage": "https://github.com/discord-ts-dev/discord.ts#readme",
  "bugs": {
    "url": "https://github.com/discord-ts-dev/discord.ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/discord-ts-dev/discord.ts.git",
    "directory": "packages/i18n"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "oxlint .",
    "format": "oxfmt --write src",
    "test": "bun test --preload=../../scripts/test-preload.ts"
  },
  "dependencies": {
    "@discord-ts-dev/common": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
