{
  "name": "@discord.ts/ux",
  "version": "1.2.0",
  "description": "discord.ts message UX helpers: confirm dialogs, pagers",
  "homepage": "https://github.com/discord-ts-dev/discord.ts#readme",
  "bugs": {
    "url": "https://github.com/discord-ts-dev/discord.ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/discord-ts-dev/discord.ts.git",
    "directory": "packages/ux"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write src",
    "test": "bun test --preload=../../scripts/test-preload.ts"
  },
  "dependencies": {
    "discord.js": "^14.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "discord.js": "^14.0.0"
  }
}
