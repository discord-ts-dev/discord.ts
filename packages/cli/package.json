{
  "name": "@discord.ts/cli",
  "version": "0.1.0",
  "description": "discord.ts command runner: dev, shard, deploy, start",
  "license": "MIT",
  "bin": {
    "discord": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write src",
    "test": "bun test --preload=../../scripts/test-preload.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.6.3"
  }
}
