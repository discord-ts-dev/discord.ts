{
  "name": "@discord-ts-dev/systems",
  "version": "0.4.0",
  "description": "discord.ts bot systems: store, scheduler, daily, quests, leaderboard, shop",
  "homepage": "https://github.com/discord-ts-dev/discord.ts#readme",
  "bugs": {
    "url": "https://github.com/discord-ts-dev/discord.ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/discord-ts-dev/discord.ts.git",
    "directory": "packages/systems"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write src",
    "test": "bun test --preload=../../scripts/test-preload.ts"
  },
  "dependencies": {
    "@discord-ts-dev/common": "^1.2.0",
    "@discord-ts-dev/ux": "^1.2.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
