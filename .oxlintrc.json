{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["react", "react_perf", "typescript", "import", "jest", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-explicit-any": "error",
    "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-debugger": "warn",
    "react/react-in-jsx-scope": "off",
    "react/no-array-index-key": "warn",
    "eslint/no-underscore-dangle": "off",
    "import/no-duplicates": ["error", { "prefer-inline": true }],
    "import/no-named-as-default-member": "off",
    "import/no-unassigned-import": "off",
    "max-lines": ["error", 300]
  },
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "plugins": ["jest", "vitest"],
      "rules": {
        "no-explicit-any": "off",
        "jest/expect-expect": "off",
        "vitest/expect-expect": "off",
        "jest/no-conditional-expect": "off",
        "vitest/no-conditional-expect": "off",
        "jest/valid-title": "off",
        "vitest/valid-title": "off",
        "vitest/require-mock-type-parameters": "off",
        // empty marker classes are how tests build modules and stubs
        "typescript/no-extraneous-class": "off"
      }
    },
    {
      // bun's coverage counts an implicit class constructor as an uncovered
      // function, so stateless classes carry an explicit empty one
      "files": [
        "packages/core/src/guards/*.guard.ts",
        "packages/core/src/discord.module.ts",
        "packages/common/src/di.ts",
        "packages/systems/src/store.ts"
      ],
      "rules": {
        "eslint/no-useless-constructor": "off"
      }
    },
    {
      // sequential by design: pipe and guard chains feed each result into the
      // next, and GitHub pagination needs page N before page N + 1
      "files": [
        "packages/core/src/discovery/discord-routing.service.ts",
        "scripts/github/triage-label.mjs"
      ],
      "rules": {
        "eslint/no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".next/**",
    "coverage/**",
    ".turbo/**",
    "build/**",
    "www/**",
    "test-results/**",
    ".expo/**"
  ]
}
