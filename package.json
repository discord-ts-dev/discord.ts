{
  "name": "discord.ts",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "postinstall": "node -e \"try{require('fs').chmodSync('packages/core/dist/cli.js',0o755)}catch{};require('fs').mkdirSync('apps/example/node_modules/.bin',{recursive:true});try{require('fs').unlinkSync('apps/example/node_modules/.bin/discord')}catch{};require('fs').symlinkSync('../../../../packages/core/dist/cli.js','apps/example/node_modules/.bin/discord')\""
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
