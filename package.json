{
  "name": "discord.ts",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build && bun run postinstall",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run build --filter='./packages/*' && bun test --coverage --preload=./scripts/test-preload.ts packages tests/surface.test.ts && bun run test:apps",
    "test:apps": "bun test --preload=./scripts/test-preload.ts apps",
    "format": "turbo run format",
    "format:check": "oxfmt --check apps packages scripts",
    "scripts:check": "oxlint scripts/github && oxfmt --check scripts/github && for f in scripts/github/*.sh; do bash -n \"$f\"; done && bash scripts/github/check-licenses.sh",
    "release": "changeset publish",
    "codemod": "bun scripts/codemods/run.ts",
    "postinstall": "bash scripts/postinstall.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@discord-ts-dev/common": "workspace:*",
    "@discord-ts-dev/core": "workspace:*",
    "@discord-ts-dev/i18n": "workspace:*",
    "@discord-ts-dev/redis": "workspace:*",
    "@discord-ts-dev/systems": "workspace:*",
    "@discord-ts-dev/utils": "workspace:*",
    "@discord-ts-dev/ux": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "oxfmt": "^0.69.0",
    "oxlint": "^1.84.0",
    "turbo": "^2.11.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2"
  }
}
