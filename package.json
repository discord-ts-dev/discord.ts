{
  "name": "discord.ts",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build && bun run postinstall",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "turbo run format",
    "format:check": "oxfmt --check apps packages scripts",
    "release": "changeset publish",
    "codemod": "bun scripts/codemods/run.ts",
    "postinstall": "bash scripts/postinstall.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
