{
  "name": "discord.ts",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build && bun run postinstall",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "bun test --coverage --preload=./scripts/test-preload.ts packages apps tests",
    "format": "turbo run format",
    "format:check": "oxfmt --check apps packages scripts",
    "scripts:check": "oxlint scripts/github && oxfmt --check scripts/github && for f in scripts/github/*.sh; do bash -n \"$f\"; done",
    "release": "changeset publish",
    "codemod": "bun scripts/codemods/run.ts",
    "postinstall": "bash scripts/postinstall.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@discord.ts/common": "workspace:*",
    "@discord.ts/core": "workspace:*",
    "@discord.ts/i18n": "workspace:*",
    "@discord.ts/systems": "workspace:*",
    "@discord.ts/utils": "workspace:*",
    "@discord.ts/ux": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.4.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
