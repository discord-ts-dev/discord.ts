{
  "name": "music-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "dev": "discord dev",
    "deploy": "discord deploy",
    "start": "discord start",
    "start:bun": "discord dev",
    "lint": "oxlint .",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@discord-ts-dev/cli": "workspace:*",
    "@discord-ts-dev/common": "workspace:*",
    "@discord-ts-dev/core": "workspace:*",
    "@discord-ts-dev/i18n": "workspace:*",
    "@discord-ts-dev/systems": "workspace:*",
    "@discord-ts-dev/utils": "workspace:*",
    "@discord-ts-dev/ux": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-validator": "^0.15.1",
    "discord.js": "^14.0.0",
    "lavalink-client": "2.11.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "dotenv": "^18.0.3",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2"
  }
}
